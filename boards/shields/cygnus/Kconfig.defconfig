if SHIELD_CYGNUS_LEFT

config ZMK_KEYBOARD_NAME
    default "CYGNUS"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_CYGNUS_LEFT || SHIELD_CYGNUS_RIGHT

config ZMK_SPLIT
    default y

endif

if SHIELD_CYGNUS_DONGLE

config ZMK_KEYBOARD_NAME
    default "CYGNUS"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# Left + right halves both connect to the dongle.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS (2) + number of BLE profiles (5).
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
